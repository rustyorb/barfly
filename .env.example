# Copy to .env.local (which is never committed) and edit. Everything here is optional.

# LM Studio on this machine. Default: http://localhost:1235
# LM_STUDIO_URL=http://localhost:1234

# A second LM Studio on another machine, and the name to show for it in Settings.
# LM_STUDIO_URL_2=http://192.168.1.50:1234
# VITE_LM_STUDIO_2_LABEL=the big PC

# An OpenAI-style voice server. Default: http://localhost:8880 (the one in voice/)
# VOICE_URL=http://localhost:8880
